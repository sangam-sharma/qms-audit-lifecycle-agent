# Optional OpenAI-compatible endpoint. Choose a provider and model with a free tier.
# No provider is selected automatically and there is no paid-provider fallback.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=8
LLM_MAX_OUTPUT_TOKENS=120

# Browser origins allowed to call the agent API. Keep this list explicit.
AGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
